MONGO_URI=
MONGO_DATABASE=
MONGO_COLLECTION=
REDIS_URL=
LOCK_TIMEOUT_SECONDS=
LOG_LEVEL=INFO
# Consul apagado en local (no hay Consul ni token). En el stack lo prende docker-compose.yml.
CONSUL_ENABLED=false
CONSUL_HTTP_ADDR=http://consul:8500
CONSUL_HTTP_TOKEN_FILE=/run/secrets/consul_microservices_token
CONSUL_SERVICE_ADDRESS=persistencia-actualizaciones
CONSUL_SERVICE_PORT=8000
